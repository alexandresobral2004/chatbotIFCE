DATABASE_URL=postgresql://rag_db:rag_password@localhost:5432/rag_db
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Segredo do JWT (mín. 32 caracteres). Compartilhado com o sistema principal se ele também emitir tokens.
CHAT_JWT_SECRET=
# false apenas em desenvolvimento local (libera o chat sem token)
CHAT_AUTH_REQUIRED=true
# Origens extras permitidas no CORS, separadas por vírgula (ex.: URL do sistema principal)
ALLOWED_ORIGINS=
